#include "CAN_DATA.h"
#include "FRO.h"
#include "fdcan.h"
#include "AKKU_FAN.h"
#include "CURRENT_SENSE.h"

static uint32_t can_last_ms = 0;
static FDCAN_TxHeaderTypeDef fusebox0_header;
static uint8_t fusebox0_data[8] = {0};

static uint32_t fan_can_last_ms = 0U;
static uint32_t fan_previous_pulse_count = 0U;
static FDCAN_TxHeaderTypeDef fan_header;
static uint8_t fan_data[8] = {0};

static uint32_t current_can_last_ms = 0U;
static FDCAN_TxHeaderTypeDef current_header;
static uint8_t current_data[8] = {0};

void CAN_DATA_Init(uint32_t now_ms)
{
  can_last_ms = now_ms;

  fusebox0_header.Identifier = 0x600U;
  fusebox0_header.IdType = FDCAN_STANDARD_ID;
  fusebox0_header.TxFrameType = FDCAN_DATA_FRAME;
  fusebox0_header.DataLength = FDCAN_DLC_BYTES_8;
  fusebox0_header.ErrorStateIndicator = FDCAN_ESI_ACTIVE;
  fusebox0_header.BitRateSwitch = FDCAN_BRS_OFF;
  fusebox0_header.FDFormat = FDCAN_CLASSIC_CAN;
  fusebox0_header.TxEventFifoControl = FDCAN_NO_TX_EVENTS;
  fusebox0_header.MessageMarker = 0U;

  fan_can_last_ms = now_ms;
  fan_previous_pulse_count = AKKU_FAN_GetPulseCount();

  fan_header.Identifier = 0x602U;
  fan_header.IdType = FDCAN_STANDARD_ID;
  fan_header.TxFrameType = FDCAN_DATA_FRAME;
  fan_header.DataLength = FDCAN_DLC_BYTES_8;
  fan_header.ErrorStateIndicator = FDCAN_ESI_ACTIVE;
  fan_header.BitRateSwitch = FDCAN_BRS_OFF;
  fan_header.FDFormat = FDCAN_CLASSIC_CAN;
  fan_header.TxEventFifoControl = FDCAN_NO_TX_EVENTS;
  fan_header.MessageMarker = 0U;

  current_can_last_ms = now_ms;

  current_header.Identifier = 0x610U;
  current_header.IdType = FDCAN_STANDARD_ID;
  current_header.TxFrameType = FDCAN_DATA_FRAME;
  current_header.DataLength = FDCAN_DLC_BYTES_8;
  current_header.ErrorStateIndicator = FDCAN_ESI_ACTIVE;
  current_header.BitRateSwitch = FDCAN_BRS_OFF;
  current_header.FDFormat = FDCAN_CLASSIC_CAN;
  current_header.TxEventFifoControl = FDCAN_NO_TX_EVENTS;
  current_header.MessageMarker = 0U;
}

void CAN_DATA_Task(uint32_t now_ms)
{
  /* Bestehende FRO-Nachricht: ID 0x600, alle 10 ms */
  if ((uint32_t)(now_ms - can_last_ms) >= 10U)
  {
    can_last_ms += 10U;

    uint16_t fro_status = FRO_GetStatus();
    fusebox0_data[6] = (uint8_t)(fro_status & 0xFFU);
    fusebox0_data[7] = (uint8_t)((fro_status >> 8) & 0x3FU);

    if (HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1,
                                      &fusebox0_header,
                                      fusebox0_data) != HAL_OK)
    {
      Error_Handler();
    }
  }

  /* Lüfterdiagnose: ID 0x602, alle 100 ms */
  if ((uint32_t)(now_ms - fan_can_last_ms) >= 100U)
  {
    fan_can_last_ms += 100U;

    uint32_t count = AKKU_FAN_GetPulseCount();
    uint32_t pulses = count - fan_previous_pulse_count;
    fan_previous_pulse_count = count;

    fan_data[0] = AKKU_FAN_IsEnabled();
    fan_data[1] = AKKU_FAN_GetDuty();
    fan_data[2] = (uint8_t)(pulses & 0xFFU);
    fan_data[3] = (uint8_t)((pulses >> 8) & 0xFFU);

    if (HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1,
                                      &fan_header,
                                      fan_data) != HAL_OK)
    	if ((uint32_t)(now_ms - current_can_last_ms) >= 10U)
    	{
    	  current_can_last_ms += 10U;

    	  uint16_t mab = CURRENT_SENSE_GetDeciAmp(CURRENT_MAB);
    	  uint16_t gp = CURRENT_SENSE_GetDeciAmp(CURRENT_GP);
    	  uint16_t radiator = CURRENT_SENSE_GetDeciAmp(CURRENT_RADIATOR);
    	  uint16_t wp = CURRENT_SENSE_GetDeciAmp(CURRENT_WP);

    	  current_data[0] = (uint8_t)(mab & 0xFFU);
    	  current_data[1] = (uint8_t)(mab >> 8);
    	  current_data[2] = (uint8_t)(gp & 0xFFU);
    	  current_data[3] = (uint8_t)(gp >> 8);
    	  current_data[4] = (uint8_t)(radiator & 0xFFU);
    	  current_data[5] = (uint8_t)(radiator >> 8);
    	  current_data[6] = (uint8_t)(wp & 0xFFU);
    	  current_data[7] = (uint8_t)(wp >> 8);

    	  if (HAL_FDCAN_AddMessageToTxFifoQ(&hfdcan1,
    	                                    &current_header,
    	                                    current_data) != HAL_OK)
    	  {
    	    Error_Handler();
    	  }
    	}
  }
}
