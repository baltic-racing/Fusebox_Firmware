static uint16_t fro_status = 0;   /* Bit 0..13: Status der Sicherungen */
static uint8_t fro_channel = 0;   /* aktuell am Multiplexer gewählter Kanal */
static uint32_t fro_last_ms = 0;

static uint8_t fro_last_channel = 0;
static uint8_t fro_last_value = 0;

static FDCAN_TxHeaderTypeDef fro_tx_header;
static uint8_t fusebox0_data[8] = {0};

