#include "CURRENT_SENSE.h"
#include "adc.h"
#include "main.h"

static uint32_t current_last_ms = 0U;
static uint16_t current_deciamp[CURRENT_COUNT] = {0};

static uint16_t CURRENT_SENSE_ReadAdc(uint32_t adc_channel)
{
  ADC_ChannelConfTypeDef config = {0};

  config.Channel = adc_channel;
  config.Rank = ADC_REGULAR_RANK_1;
  config.SamplingTime = ADC_SAMPLETIME_640CYCLES_5;
  config.SingleDiff = ADC_SINGLE_ENDED;
  config.OffsetNumber = ADC_OFFSET_NONE;
  config.Offset = 0;

  if (HAL_ADC_ConfigChannel(&hadc1, &config) != HAL_OK)
  {
    Error_Handler();
  }

  if (HAL_ADC_Start(&hadc1) != HAL_OK)
  {
    Error_Handler();
  }

  if (HAL_ADC_PollForConversion(&hadc1, 2U) != HAL_OK)
  {
    HAL_ADC_Stop(&hadc1);
    Error_Handler();
  }

  uint16_t raw = (uint16_t)HAL_ADC_GetValue(&hadc1);

  if (HAL_ADC_Stop(&hadc1) != HAL_OK)
  {
    Error_Handler();
  }

  return raw;
}

static uint16_t CURRENT_SENSE_Convert(uint16_t raw)
{
  /*
   * Schaltplanannahmen:
   * ADC: 12 Bit, VDDA = 3300 mV
   * Sense-Widerstand: 820 Ohm
   * Verhältnis K: 5770
   *
   * Ergebnis in 0,1 A. uint64_t verhindert Überlauf
   * bei den Zwischenrechnungen.
   */
  uint64_t numerator = (uint64_t)raw * 3300U * 5770U;
  uint64_t denominator = (uint64_t)4095U * 820U * 100U;

  return (uint16_t)((numerator + denominator / 2U) / denominator);
}

void CURRENT_SENSE_Init(uint32_t now_ms)
{
  current_last_ms = now_ms;

  if (HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED) != HAL_OK)
  {
    Error_Handler();
  }
}

void CURRENT_SENSE_Task(uint32_t now_ms)
{
  if ((uint32_t)(now_ms - current_last_ms) < 10U)
  {
    return;
  }

  current_last_ms += 10U;

  /* Zuordnung aus Controller.SchDoc und HSD.SchDoc */
  current_deciamp[CURRENT_MAB] =
      CURRENT_SENSE_Convert(CURRENT_SENSE_ReadAdc(ADC_CHANNEL_6)); /* PC0 */

  current_deciamp[CURRENT_GP] =
      CURRENT_SENSE_Convert(CURRENT_SENSE_ReadAdc(ADC_CHANNEL_7)); /* PC1 */

  current_deciamp[CURRENT_RADIATOR] =
      CURRENT_SENSE_Convert(CURRENT_SENSE_ReadAdc(ADC_CHANNEL_3)); /* PA2 */

  current_deciamp[CURRENT_WP] =
      CURRENT_SENSE_Convert(CURRENT_SENSE_ReadAdc(ADC_CHANNEL_4)); /* PA3 */
}

uint16_t CURRENT_SENSE_GetDeciAmp(CurrentSenseChannel channel)
{
  if (channel >= CURRENT_COUNT)
  {
    return 0U;
  }

  return current_deciamp[channel];
}
