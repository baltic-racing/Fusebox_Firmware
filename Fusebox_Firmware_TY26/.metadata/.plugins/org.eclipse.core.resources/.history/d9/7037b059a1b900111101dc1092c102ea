#include "AKKU_FAN.h"
#include "main.h"
#include "tim.h"

#define FAN_PERIOD_TICKS 2150U

static volatile uint8_t fan_duty_percent = 58U;
static volatile uint8_t fan_enabled = 0U;
static uint8_t high_phase = 0U;

void AKKU_FAN_Init(void)
{
  HAL_GPIO_WritePin(FAN_TSAC_CTRL_GPIO_Port, FAN_TSAC_CTRL_Pin,
                    GPIO_PIN_RESET);
  HAL_GPIO_WritePin(FAN_TSAC_SW_GPIO_Port, FAN_TSAC_SW_Pin,
                    GPIO_PIN_RESET);

  fan_enabled = 0U;
  high_phase = 0U;

  if (HAL_TIM_Base_Start_IT(&htim6) != HAL_OK)
  {
    Error_Handler();
  }
}

void AKKU_FAN_SetDuty(uint8_t percent)
{
  if (percent > 100U)
  {
    percent = 100U;
  }

  fan_duty_percent = percent;
}

void AKKU_FAN_Enable(uint8_t enable)
{
  fan_enabled = (enable != 0U) ? 1U : 0U;

  if (fan_enabled == 0U)
  {
    HAL_GPIO_WritePin(FAN_TSAC_SW_GPIO_Port, FAN_TSAC_SW_Pin,
                      GPIO_PIN_RESET);
    HAL_GPIO_WritePin(FAN_TSAC_CTRL_GPIO_Port, FAN_TSAC_CTRL_Pin,
                      GPIO_PIN_RESET);
  }
  else
  {
    HAL_GPIO_WritePin(FAN_TSAC_SW_GPIO_Port, FAN_TSAC_SW_Pin,
                      GPIO_PIN_SET);
  }
}

void AKKU_FAN_TimerElapsed(TIM_HandleTypeDef *htim)
{
  if (htim->Instance != TIM6)
  {
    return;
  }

  uint8_t duty = fan_duty_percent;

  if ((fan_enabled == 0U) || (duty == 0U))
  {
    high_phase = 0U;
    HAL_GPIO_WritePin(FAN_TSAC_CTRL_GPIO_Port, FAN_TSAC_CTRL_Pin,
                      GPIO_PIN_RESET);
    __HAL_TIM_SET_AUTORELOAD(htim, FAN_PERIOD_TICKS - 1U);
    return;
  }

  if (duty == 100U)
  {
    high_phase = 1U;
    HAL_GPIO_WritePin(FAN_TSAC_CTRL_GPIO_Port, FAN_TSAC_CTRL_Pin,
                      GPIO_PIN_SET);
    __HAL_TIM_SET_AUTORELOAD(htim, FAN_PERIOD_TICKS - 1U);
    return;
  }

  uint32_t high_ticks = ((uint32_t)FAN_PERIOD_TICKS * duty) / 100U;

  if (high_phase == 0U)
  {
    high_phase = 1U;
    HAL_GPIO_WritePin(FAN_TSAC_CTRL_GPIO_Port, FAN_TSAC_CTRL_Pin,
                      GPIO_PIN_SET);
    __HAL_TIM_SET_AUTORELOAD(htim, high_ticks - 1U);
  }
  else
  {
    high_phase = 0U;
    HAL_GPIO_WritePin(FAN_TSAC_CTRL_GPIO_Port, FAN_TSAC_CTRL_Pin,
                      GPIO_PIN_RESET);
    __HAL_TIM_SET_AUTORELOAD(htim,
                             FAN_PERIOD_TICKS - high_ticks - 1U);
  }
}
